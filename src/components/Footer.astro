---
import { business, hours } from '../data/content';
const year = new Date().getFullYear();
---

<footer data-surface="dark" class="relative overflow-hidden border-t border-white/[0.08] bg-ink pt-20">
  <div
    class="pointer-events-none absolute -top-32 left-1/2 h-64 w-[42rem] -translate-x-1/2 rounded-full bg-amber/12 blur-[120px]"
  >
  </div>

  <div class="relative mx-auto max-w-edge px-5">
    <div class="grid gap-12 pb-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3">
          <img
            src={business.profilePic}
            alt="Cavern brand mark"
            width="48"
            height="48"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            class="h-12 w-12 rounded-full object-cover ring-1 ring-white/12"
          />
          <div>
            <p class="font-display text-lg font-extrabold tracking-tight text-bone">Cavern</p>
            <p class="font-mono text-[10px] uppercase tracking-[0.28em] text-sand/60">کاڤێرن · Erbil</p>
          </div>
        </div>

        <p class="mt-6 max-w-sm text-sm leading-relaxed text-bone/60">
          {business.bio[0]}<br />{business.bio[1]}
        </p>

        <p class="mt-6 font-script text-3xl italic text-amber">A shared table in Erbil.</p>
      </div>

      <nav aria-label="Footer" class="lg:col-span-2">
        <p class="font-mono text-[9px] uppercase tracking-[0.28em] text-sand/50">Explore</p>
        <ul class="mt-4 space-y-2.5">
          {
            [
              ['Story', '#story'],
              ['Rituals', '#rituals'],
              ['Gallery', '#gallery'],
              ['Reviews', '#reviews'],
              ['Visit', '#visit'],
            ].map(([label, href]) => (
              <li>
                <a
                  href={href}
                  class="text-sm text-bone/70 transition-colors hover:text-amber"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-2">
        <p class="font-mono text-[9px] uppercase tracking-[0.28em] text-sand/50">Hours</p>
        <ul class="mt-4 space-y-2.5 text-sm text-bone/70">
          <li>{hours.label} · {hours.display}</li>
          <li>Breakfast from 9:00 AM</li>
          <li>Dining from 1:00 PM</li>
        </ul>
      </div>

      <address class="not-italic lg:col-span-3">
        <p class="font-mono text-[9px] uppercase tracking-[0.28em] text-sand/50">Find us</p>
        <ul class="mt-4 space-y-2.5 text-sm text-bone/70">
          <li>{business.addressLines.join(', ')}</li>
          <li>
            <a href={`tel:${business.phoneHref}`} class="transition-colors hover:text-amber">
              {business.phone}
            </a>
          </li>
          <li>
            <a
              href={business.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-amber"
            >
              @{business.instagram}
            </a>
          </li>
          <li>
            <a
              href={business.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-amber"
            >
              Open in Google Maps →
            </a>
          </li>
        </ul>
      </address>
    </div>

    <div class="rule opacity-60"></div>

    <div class="flex flex-col items-center justify-between gap-4 py-8 sm:flex-row">
      <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-sand/45">
        © {year} Cavern — کاڤێرن · All rights reserved
      </p>
      <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-sand/45">
        Rated {business.rating} ★ · {business.reviewCount} Google reviews
      </p>
    </div>
  </div>
</footer>