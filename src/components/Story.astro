---
import { business, googlePhotos } from '../data/content';
---

<section id="story" data-surface="light" class="relative bg-bone py-24 text-ink md:py-36">
  <div class="mx-auto max-w-edge px-5">
    <div class="grid items-start gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow-dim" data-reveal>Our story · 002</p>
        <h2
          class="mt-6 font-display text-[clamp(2rem,5.6vw,4.2rem)] font-extrabold leading-[0.98] tracking-[-0.03em]"
          data-reveal
          style="--d:80ms"
        >
          A shared table<br />in <span class="font-script italic font-normal text-ember">Erbil</span>.
        </h2>
        <p class="mt-7 max-w-lg text-[15px] leading-relaxed text-ink/70 sm:text-base" data-reveal style="--d:160ms">
          We built Cavern for the long conversations — the ones that start over breakfast and end
          somewhere past midnight. Warm plaster, raw stone, low amber light and a kitchen that never
          rushes you.
        </p>
        <p class="mt-4 max-w-lg text-[15px] leading-relaxed text-ink/60 sm:text-base" data-reveal style="--d:220ms">
          Walk in for a flat white at nine. Stay for a slow dinner from one o’clock. Come back on a
          Wednesday for candlelight and flowers.
        </p>

        <div class="mt-10 grid grid-cols-2 gap-x-8 gap-y-6" data-reveal style="--d:280ms">
          {
            [
              ['Breakfast', 'Daily · from 9:00 AM'],
              ['Kitchen', 'Dining from 1:00 PM'],
              ['Signature', 'Tea on the house'],
              ['Evenings', 'Live nights · weekly'],
            ].map(([k, v]) => (
              <div class="border-t border-ink/12 pt-3">
                <p class="font-mono text-[9px] uppercase tracking-[0.26em] text-ink/45">{k}</p>
                <p class="mt-1.5 text-sm font-semibold text-ink/85">{v}</p>
              </div>
            ))
          }
        </div>

        <a href="#visit" class="btn-ghost mt-10 text-ink"> Plan your visit </a>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:col-span-7" data-reveal style="--d:200ms">
        {
          googlePhotos.slice(0, 6).map((src, i) => (
            <figure
              class:list={[
                'group relative overflow-hidden rounded-2xl bg-ink/5',
                i === 0 ? 'col-span-2 row-span-2 aspect-[4/3] sm:col-span-2' : 'aspect-square',
              ]}
            >
              <img
                src={src}
                alt={`Cavern interior and table detail, photo ${i + 1}`}
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
                width="300"
                height="225"
                class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.06]"
              />
              <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/45 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></span>
            </figure>
          ))
        }
      </div>
    </div>

    <div class="mt-20 flex flex-wrap items-center justify-between gap-6 border-t border-ink/12 pt-8" data-reveal>
      <p class="font-mono text-[10px] uppercase tracking-[0.28em] text-ink/45">
        {business.address}
      </p>
      <p class="font-script text-2xl italic text-ember">Cavern · کاڤێرن</p>
    </div>
  </div>
</section>