---
import { events } from '../data/content';
---

<section id="rituals" data-surface="dark" class="relative bg-ink py-24 md:py-36">
  <div class="mx-auto max-w-edge px-5">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <div>
        <p class="eyebrow" data-reveal>Rituals · 003</p>
        <h2
          class="mt-6 max-w-2xl font-display text-[clamp(2rem,5.6vw,4.2rem)] font-extrabold leading-[0.98] tracking-[-0.03em] text-bone"
          data-reveal
          style="--d:80ms"
        >
          Nights that keep<br />the town <span class="font-script italic font-normal text-amber">talking</span>.
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-bone/60" data-reveal style="--d:140ms">
        Trivia, karaoke, candlelit bloom nights and private ceremonies — all hosted at Cavern
        Diamond. Tables go fast; reserve early.
      </p>
    </div>

    <div class="mt-16 grid gap-5 md:grid-cols-2">
      {
        events.map((e, i) => (
          <article
            data-tilt
            class="group relative overflow-hidden rounded-3xl border border-white/[0.08] bg-basalt/60"
            data-reveal
            style={`--d:${i * 90}ms`}
          >
            <div data-tilt-inner class="relative">
              <div class="relative aspect-[16/10] overflow-hidden">
                <img
                  src={e.image}
                  alt={e.title}
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  class="h-full w-full object-cover opacity-80 transition-transform duration-[1400ms] ease-out group-hover:scale-[1.07] group-hover:opacity-100"
                />
                <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink via-ink/35 to-transparent" />
              </div>

              <div class="relative -mt-16 p-6 sm:p-7">
                <p class="font-mono text-[10px] uppercase tracking-[0.24em] text-amber/90">
                  {e.meta}
                </p>
                <h3 class="mt-3 font-display text-2xl font-extrabold tracking-tight text-bone sm:text-3xl">
                  {e.title}
                </h3>
                <p class="mt-3 max-w-md text-sm leading-relaxed text-bone/65">{e.copy}</p>
                <span class="mt-6 inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.2em] text-bone/70 transition-colors group-hover:text-amber">
                  Reserve a table <span aria-hidden="true">→</span>
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>